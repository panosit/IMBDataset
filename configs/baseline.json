    "linear_svc": {"C": [0.1, 1.0, 5.0]},
    "multinomial_nb": {"alpha": [0.1, 0.5, 1.0]}
  },
  "tfidf": {"max_features": [10000, 20000], "min_df": [2, 5], "ngram_range": [[1, 1], [1, 2]], "sublinear_tf": true}
}
