{
  "data_path": "data/raw/imdb_dataset.csv",
  "output_dir": "outputs/baseline",
  "seed": 42,
  "test_size": 0.2,
  "outer_folds": 5,
  "inner_folds": 3,
  "bootstrap_iterations": 1000,
  "models": {
